# Get this from Supabase → click "Connect" → Transaction pooler.
# The ?pgbouncer=true&connection_limit=1 suffix is required — the pooler
# doesn't support prepared statements without it.
DATABASE_URL="postgresql://postgres.sisqxtsnnymkowddjdgd:danny08074561313@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Same connection, but port 5432 (Session pooler) instead of 6543 — only
# `prisma migrate` uses this one. Just copy DATABASE_URL and change the port.
DIRECT_URL="postgresql://postgres.sisqxtsnnymkowddjdgd:danny08074561313@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

