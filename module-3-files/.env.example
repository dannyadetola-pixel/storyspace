# Get this from Supabase → click "Connect" → Transaction pooler.
# The ?pgbouncer=true&connection_limit=1 suffix is required — the pooler
# doesn't support prepared statements without it.
DATABASE_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Same connection, but port 5432 (Session pooler) instead of 6543 — only
# `prisma migrate` uses this one. Just copy DATABASE_URL and change the port.
DIRECT_URL="postgresql://postgres.xxxxx:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# http://localhost:3000 while developing; your real domain once deployed
NEXTAUTH_URL="http://localhost:3000"

# From Google Cloud Console → APIs & Services → Credentials (see README)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Same Supabase project as DATABASE_URL — Storage just needs its API URL and
# a privileged key instead of a Postgres connection string.
# Get both from Project Settings → API Keys (or the same "Connect" dialog
# used earlier). SUPABASE_URL looks like https://xxxxx.supabase.co.
# The key may be called "service_role" or, on newer projects, "secret" —
# either works the same way here.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
